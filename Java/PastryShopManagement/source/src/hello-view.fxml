<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.gui.HelloController">
    <Tab text="Torturi">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TableView fx:id="tableTort" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTortId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTortTip" text="Tip Tort" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <TextField fx:id="txtTortId" promptText="ID"/>
                <TextField fx:id="txtTortTip" promptText="Tip Tort" HBox.hgrow="ALWAYS"/>
                <Button text="Adauga" onAction="#onAddTort"/>
                <Button text="Actualizeaza" onAction="#onUpdateTort"/>
                <Button text="Sterge" onAction="#onDeleteTort"/>
            </HBox>
        </VBox>
    </Tab>
    <Tab text="Comenzi">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TableView fx:id="tableComanda" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCmdId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colCmdData" text="Data" prefWidth="150"/>
                    <TableColumn fx:id="colCmdTorturi" text="Continut" prefWidth="300"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <TextField fx:id="txtCmdId" promptText="ID Comanda"/>
                <TextField fx:id="txtCmdTortIds" promptText="ID-uri Torturi (ex: 1,2,3)" HBox.hgrow="ALWAYS"/>
                <Button text="Adauga" onAction="#onAddComanda"/>
                <Button text="Actualizeaza" onAction="#onUpdateComanda"/>
                <Button text="Sterge" onAction="#onDeleteComanda"/>
            </HBox>
        </VBox>
    </Tab>
    <Tab text="Rapoarte">
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Genereaza Rapoarte" onAction="#onGenerateReports"/>
            <TextArea fx:id="txtReports" VBox.vgrow="ALWAYS" editable="false"/>
        </VBox>
    </Tab>
</TabPane>